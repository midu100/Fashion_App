PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DB_STRING=mongodb://127.0.0.1:27017/kazir-nation
JWT_SEC=your_secret_here
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SEC=

# Gmail SMTP for OTP / reset emails (utils/emailServices.js).
# APP_PASSWORD = a Google App Password (needs 2FA on), NOT your account password.
EMAIL_USER=
APP_PASSWORD=

# ====== AI assistant (provider-swappable) ======
# Free now: Gemini. Get a free key at https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
AGENT_MODEL=
# Future paid drop-in — set AI_PROVIDER=anthropic + add the key + create llm/anthropic.js
ANTHROPIC_API_KEY=
# Optional: owner email for the scheduled AI business digest
AGENT_DIGEST_TO=
